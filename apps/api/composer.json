{
  "name": "yume/api",
  "description": "Yume HTTP API — Domain / Application / Infrastructure / Presentation.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-sodium": "*",
    "yume/contracts": "*",
    "yume/database": "*",
    "yume/security": "*",
    "yume/shared": "*"
  },
  "autoload": {
    "psr-4": {
      "Yume\\Api\\": "src/"
    }
  },
  "repositories": [
    { "type": "path", "url": "../../packages/*" }
  ],
  "config": {
    "sort-packages": true
  }
}
