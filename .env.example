# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Generate the two secrets with:
#   openssl rand -base64 32

# ------------------------------------------------------------------ application
APP_NAME=Yume
APP_ENV=local                 # local | staging | production
APP_DEBUG=true                # MUST be false in production
APP_VERSION=0.1.0-dev
APP_URL=http://localhost:8080
APP_PORT=8080

# Signs CSRF tokens. Minimum 32 bytes. Rotating it invalidates outstanding
# CSRF tokens but not sessions.
APP_SECRET=change-me-openssl-rand-base64-32

# --------------------------------------------------------------------- database
DB_DATABASE=yume
DB_USERNAME=yume
DB_PASSWORD=change-me-openssl-rand-base64-32
DB_CONNECT_TIMEOUT=5
DB_PORT_PUBLISHED=55432       # host port for the dev postgres; unpublished in production

# --------------------------------------------------------------------- security
SESSION_LIFETIME_SECONDS=2592000        # 30 days, absolute
SESSION_IDLE_EXTENSION_SECONDS=1209600  # 14 days, sliding
SESSION_ROTATE_AFTER_SECONDS=3600
SESSION_MAX_CONCURRENT=10
SESSION_SECURE_COOKIES=false            # MUST be true anywhere with TLS

PASSWORD_MIN_LENGTH=12
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=4
ARGON2_THREADS=2
AUTH_MAX_FAILED_ATTEMPTS=8
AUTH_LOCK_SECONDS=900

# Only these may set X-Forwarded-For. Anything else is treated as a risk signal.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,127.0.0.1

# Comma separated, exact origins. Never a wildcard: credentials are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000

SECURITY_HSTS=false                     # true in production

# Risk engine thresholds (0-100)
RISK_THRESHOLD_MONITOR=20
RISK_THRESHOLD_RATE_LIMIT=40
RISK_THRESHOLD_CHALLENGE=60
RISK_THRESHOLD_RESTRICT=75
RISK_THRESHOLD_BLOCK=90
RISK_ALLOWED_USER_AGENTS=

# --------------------------------------------------------------------- services
LOG_STREAM=php://stderr
LOG_LEVEL=debug                         # debug | info | warning | error | critical
LOG_CHANNEL=api

QUEUE_NAME=default
QUEUE_MAX_ATTEMPTS=5
QUEUE_POLL_INTERVAL=2

CACHE_PREFIX=yume:
CACHE_DEFAULT_TTL=300

MAIL_DRIVER=log                         # log | smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@yume.local
MAILPIT_UI_PORT=8025
ADMINER_PORT=8081

# ----------------------------------------------------------------- feature flags
# Overrides the database value for local development. Format:
#   FEATURE_<UPPERCASE_FLAG_KEY>=true
FEATURE_ENV_OVERRIDES=true
# FEATURE_NEW_FANSUB_PAGE=true

# ------------------------------------------------------------ production (TLS)
# DOMAIN=yume.example.org
# ACME_EMAIL=ops@example.org
