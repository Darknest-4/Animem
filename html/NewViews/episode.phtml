  function wh() {
    return window.innerHeight;
  }

  function cl(a) {
    console.log(a)
  }

  let videoHeight = 0;

  window.onload = jsonzx100();

  function jsonzx100() {
    let videoHeight = 0;
    videoHeight = ((GEBI('video').offsetWidth / 16) * 9);
    if (wh() < videoHeight)
      GEBI('video').style.height = wh() + "px";
    else
      GEBI('video').style.height = videoHeight + "px";

    videoHeight = ((GEBI('videoPlayer').offsetWidth / 16) * 9);
    if (wh() < videoHeight)
      GEBI('videoPlayer').style.height = wh() + "px";
    else
      GEBI('videoPlayer').style.height = videoHeight + "px";
  }
  jQuery(window).resize(function() {

    videoHeight = ((GEBI('video').offsetWidth / 16) * 9);
    if (wh() < videoHeight)
      GEBI('video').style.height = wh() + "px";
    else
      GEBI('video').style.height = videoHeight + "px";

    videoHeight = ((GEBI('videoPlayer').offsetWidth / 16) * 9);
    if (wh() < videoHeight)
      GEBI('videoPlayer').style.height = wh() + "px";
    else
      GEBI('videoPlayer').style.height = videoHeight + "px";

  });

  function GEBI(id) {
    if (typeof document.getElementById(id) === 'undefined' || document.getElementById(id) === null) return NULL;
    else return document.getElementById(id);
