{
  "name": "yume/monorepo",
  "description": "Yume — modular monolith backend. Clean architecture, CQRS use cases, PostgreSQL, Docker.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-sodium": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.68",
    "vimeo/psalm": "^6.0",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Yume\\Api\\": "apps/api/src/",
      "Yume\\Contracts\\": "packages/Contracts/src/",
      "Yume\\Shared\\": "packages/Shared/src/",
      "Yume\\Database\\": "packages/Database/src/",
      "Yume\\Security\\": "packages/Security/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Yume\\Tests\\": "apps/api/tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c apps/api/phpunit.xml",
    "test:unit": "phpunit -c apps/api/phpunit.xml --testsuite=unit",
    "test:security": "phpunit -c apps/api/phpunit.xml --testsuite=security",
    "stan": "phpstan analyse --configuration=phpstan.neon",
    "lint": "php-cs-fixer fix --dry-run --diff",
    "fix": "php-cs-fixer fix",
    "psalm": "psalm --config=psalm.xml",
    "check": ["@lint", "@stan", "@test"]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": false
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
